{
  "name": "@dismock/client",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./register": { "default": "./dist/register.js" },
    "./shims/*": { "default": "./dist/shims/*.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dismock/server": "workspace:*",
    "@electric-sql/pglite": "^0.5.14",
    "drizzle-kit": "^0.31.11",
    "ws": "^8.22.1"
  },
  "peerDependencies": { "discord.js": "^14" },
  "devDependencies": { "@types/ws": "^8.18.2", "discord.js": "^14.28.0" }
}
