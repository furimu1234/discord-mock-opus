{
  "name": "@dismock/test",
  "version": "0.1.1",
  "description": "dismock の Mock の上で Discord の Bot をテストするテストランナーとテスト DSL",
  "keywords": [
    "discord",
    "discord.js",
    "mock",
    "testing",
    "bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furimu1234/discord-mock-opus.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/furimu1234/discord-mock-opus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#server-constants": {
      "types": "./vendor/server-constants.d.ts",
      "default": "./vendor/server-constants.js"
    }
  },
  "bin": {
    "dismock": "./bin/dismock.js"
  },
  "files": [
    "bin",
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/vendor-server-constants.mjs && tsc -p tsconfig.json",
    "watch": "node ../../scripts/vendor-server-constants.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "node ../../scripts/vendor-server-constants.mjs && tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@dismock/client": "workspace:*",
    "expect": "^30.5.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest-mock": "^30.5.2",
    "tsx": "^4.23.15",
    "v8-to-istanbul": "^9.3.0"
  },
  "devDependencies": {
    "@dismock/server": "workspace:*",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4"
  }
}
