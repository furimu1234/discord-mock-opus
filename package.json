{
  "name": "discord-mock-opus",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' run build",
    "web": "pnpm --filter @dismock/server run build && node apps/server/bin/dismock-server.js",
    "test": "pnpm run build && node scripts/run-tests.mjs",
    "app": "node scripts/app.mjs",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
